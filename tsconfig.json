{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "include": ["src", "tests", "scripts", "playwright.config.ts"]
}
